<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab1.MainPage"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="10" RowSpacing="8">

        <!-- Панель кнопок -->
        <FlexLayout x:Name="ButtonsPanel" Grid.Row="0" Wrap="Wrap" AlignItems="Center">
            <Button Text="Нова" Clicked="New_Clicked" ToolTipProperties.Text="Створити нову порожню таблицю" />
            <Button Text="Відкрити" Clicked="OpenLocal_Clicked" ToolTipProperties.Text="Відкрити таблицю з папки Документи\Lab1Tables" />
            <Button Text="Зберегти" Clicked="SaveLocal_Clicked" ToolTipProperties.Text="Зберегти таблицю в папку Документи\Lab1Tables" />
            <Button Text="Відкрити з Google Drive" Clicked="OpenDrive_Clicked" BackgroundColor="#1A73E8" />
            <Button Text="Зберегти на Google Drive" Clicked="SaveDrive_Clicked" BackgroundColor="#1A73E8" />
            <Button Text="Вийти з Google" Clicked="SignOut_Clicked" BackgroundColor="#5F6368" />

            <BoxView WidthRequest="12" HeightRequest="1" Color="Transparent" />

            <Button Text="+ Рядок" Clicked="AddRow_Clicked" />
            <Button Text="− Рядок" Clicked="RemoveRow_Clicked" />
            <Button Text="+ Стовпчик" Clicked="AddColumn_Clicked" />
            <Button Text="− Стовпчик" Clicked="RemoveColumn_Clicked" />

            <BoxView WidthRequest="12" HeightRequest="1" Color="Transparent" />

            <Button x:Name="ModeButton" Text="Режим: ЗНАЧЕННЯ" Clicked="Mode_Clicked" BackgroundColor="#B26A00"
                    ToolTipProperties.Text="Перемкнути відображення: вирази / значення" />
            <Button Text="Довідка" Clicked="Help_Clicked" BackgroundColor="#5F6368" />
            <Button Text="Про програму" Clicked="About_Clicked" BackgroundColor="#5F6368" />
        </FlexLayout>

        <!-- Рядок виразу вибраної клітинки -->
        <Grid Grid.Row="1" ColumnDefinitions="70,*,Auto" ColumnSpacing="6">
            <Label x:Name="CellNameLabel" Text="A1" FontSize="16" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" TextColor="#1F6E43" />
            <Entry x:Name="FormulaEntry" Grid.Column="1"
                   Placeholder="Вираз для вибраної клітинки, наприклад: (A1 > 2^10) and not (B2 = 0)"
                   Completed="FormulaEntry_Completed" />
            <Button Grid.Column="2" Text="Застосувати" Clicked="FormulaEntry_Completed" />
        </Grid>

        <!-- Сама таблиця (заповнюється з коду) -->
        <ScrollView Grid.Row="2" Orientation="Both">
            <Grid x:Name="TableGrid" ColumnSpacing="1" RowSpacing="1" BackgroundColor="#C8C8C8"
                  HorizontalOptions="Start" VerticalOptions="Start" />
        </ScrollView>

        <!-- Рядок стану -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False"
                               WidthRequest="20" HeightRequest="20" Color="#1A73E8" />
            <Label x:Name="StatusLabel" Grid.Column="1" VerticalOptions="Center"
                   LineBreakMode="WordWrap" TextColor="#333333" />
        </Grid>
    </Grid>
</ContentPage>
